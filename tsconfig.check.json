{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "tests/spec/**/*.spec.ts",
    "tests/unit/**/*.test.ts",
    "tests/support/**/*.ts",
    "tests/support/**/*.mts"
  ],
  "exclude": []
}
