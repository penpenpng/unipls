{
  "name": "unipls-monorepo",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm --filter unipls check",
    "format": "pnpm --filter unipls format",
    "format:check": "pnpm --filter unipls format:check",
    "lint": "pnpm --filter unipls lint",
    "prepare": "lefthook install",
    "test": "pnpm --filter unipls test",
    "typecheck": "pnpm --filter unipls typecheck",
    "docs:dev": "pnpm --filter unipls-docs docs:dev",
    "docs:build": "pnpm --filter unipls-docs docs:build",
    "docs:preview": "pnpm --filter unipls-docs docs:preview"
  },
  "devDependencies": {
    "lefthook": "^2.1.5"
  }
}
